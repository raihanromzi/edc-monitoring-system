{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens for Mandiri EDC Monitoring. Map-first, light glassmorphic spatial UI.",
  "color": {
    "canvas": { "$value": "#F4F6F9", "$type": "color" },
    "surface-glass": { "$value": "rgba(255, 255, 255, 0.92)", "$type": "color" },
    "surface-subtle": { "$value": "#F8FAFC", "$type": "color" },
    "surface-hover": { "$value": "#F1F5F9", "$type": "color" },
    "border-hairline": { "$value": "rgba(15, 23, 42, 0.08)", "$type": "color" },
    "border-control": { "$value": "#E2E8F0", "$type": "color" },
    "text-primary": { "$value": "#0F172A", "$type": "color" },
    "text-secondary": { "$value": "#475569", "$type": "color" },
    "text-muted": { "$value": "#94A3B8", "$type": "color" },
    "accent-cobalt": { "$value": "#2563EB", "$type": "color" },
    "accent-sky": { "$value": "#38BDF8", "$type": "color" },
    "status-teal": { "$value": "#0D9488", "$type": "color" },
    "status-amber": { "$value": "#D97706", "$type": "color" },
    "status-emerald": { "$value": "#10B981", "$type": "color" },
    "status-red": { "$value": "#DC2626", "$type": "color" }
  },
  "font": {
    "sans": { "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "\"JetBrains Mono\", monospace", "$type": "fontFamily" }
  },
  "radius": {
    "panel": { "$value": "16px", "$type": "dimension" },
    "card": { "$value": "12px", "$type": "dimension" },
    "control": { "$value": "10px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "panel": { "$value": "0 12px 36px -4px rgba(15, 23, 42, 0.09), 0 2px 6px rgba(15, 23, 42, 0.04)", "$type": "shadow" },
    "control": { "$value": "0 4px 12px rgba(15, 23, 42, 0.05)", "$type": "shadow" }
  },
  "blur": {
    "glass": { "$value": "20px", "$type": "dimension" }
  }
}
